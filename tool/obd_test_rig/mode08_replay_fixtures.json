      "description": "Multi-block responses fragmented into irregular TCP stream byte chunks do not alter decoded outcome",
      "steps": [
        {
          "command": "0800",
          "lines": ["7E8 06 48 00 80 00 00 01"],
          "chunk_sizes": [1, 2, 5, 3],
          "delay_ms": 5
