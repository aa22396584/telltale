              "supportedTids": [1, 32]
            },
            "32": {
              "supportStatus": "supported",
              "supportedTids": [33]
            }
          },
          "7E9": {
            "0": {
              "supportStatus": "supported",
              "supportedTids": [2]
            }
          }
        }
      }
