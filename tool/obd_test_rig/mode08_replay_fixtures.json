{
  "version": "1.0.0",
  "name": "mode08_replay_fixtures",
  "provenance": "synthetic",
  "description": "Synthetic Mode 08 replay transcripts and independent ground-truth expected outcomes for Mode 08 Replay Oracle & Acceptance Gate 1.",
  "scenarios": [
    {
      "id": "normal_headered_single_block",
      "dimension": "normal_control",
      "description": "Single block query with legal CAN header completing with supported TID 0x01",
      "steps": [
        {
          "command": "0800",
          "lines": ["7E8 06 48 00 80 00 00 00"]
        }
      ],
      "expected_outcome": {
        "isSupported": true,
        "supportStatus": "supported",
        "supportedTids": [1],
        "isComplete": true,
        "unqueriedBlocks": [],
        "failureReasonContains": null,
        "trustedEcus": ["7E8"],
        "hasAnonymous": false,
        "perEcuBlockResults": {
          "7E8": {
            "0": {
              "supportStatus": "supported",
              "supportedTids": [1]
            }
          }
        }
      }
    },
    {
      "id": "normal_headered_multi_block",
      "dimension": "normal_control",
      "description": "Multi-block query (0800 -> 0820) with legal CAN header completing with TIDs 0x01, 0x20, 0x22",
      "steps": [
        {
          "command": "0800",
          "lines": ["7E8 06 48 00 80 00 00 01"]
        },
        {
          "command": "0820",
          "lines": ["7E8 06 48 20 40 00 00 00"]
        }
      ],
      "expected_outcome": {
        "isSupported": true,
        "supportStatus": "supported",
        "supportedTids": [1, 32, 34],
        "isComplete": true,
        "unqueriedBlocks": [],
        "failureReasonContains": null,
        "trustedEcus": ["7E8"],
        "hasAnonymous": false,
        "perEcuBlockResults": {
          "7E8": {
            "0": {
              "supportStatus": "supported",
              "supportedTids": [1, 32]
            },
            "32": {
              "supportStatus": "supported",
              "supportedTids": [34]
            }
          }
        }
      }
    },
    {
      "id": "entry_raw_fallback_with_error",
      "dimension": "parser_entry_consistency",
      "description": "Raw lines fallback with negative response and peer NO DATA preserves transaction uncertainty",
      "steps": [
        {
          "command": "0800",
          "lines": [
            "7E8 03 7F 08 11",
            "NO DATA"
          ]
        }
      ],
      "expected_outcome": {
        "isSupported": false,
        "supportStatus": "unknown",
        "supportedTids": [],
        "isComplete": false,
        "unqueriedBlocks": [0],
        "failureReasonContains": null,
        "trustedEcus": ["7E8"],
        "hasAnonymous": true,
        "perEcuBlockResults": {
          "7E8": {
            "0": {
              "supportStatus": "unsupported",
              "supportedTids": [],
              "nrc": 17
            }
          }
        }
      }
    },
    {
      "id": "entry_multiline_raw_structured_equivalence",
      "dimension": "parser_entry_consistency",
      "description": "Multiline response yields identical supported TIDs and support status across parser entries",
      "steps": [
        {
          "command": "0800",
          "lines": ["7E8 06 48 00 C0 00 00 00"]
        }
      ],
      "expected_outcome": {
        "isSupported": true,
        "supportStatus": "supported",
        "supportedTids": [1, 2],
        "isComplete": true,
        "unqueriedBlocks": [],
