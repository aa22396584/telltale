  "connectTransportBleDescription": "GATT UART — a newer low-energy adapter",
  "@connectTransportBleDescription": {
    "description": "Subtitle of the Bluetooth LE tile on the connect screen. GATT and UART are on docs/i18n/do-not-translate.md. Must NOT tell the driver to pair the adapter: a BLE adapter is discovered by scanning inside the app, and pairing it in system settings is the route that does not work (connectAnswerBleWithClassic says so at length)."
  },
  "connectTransportBleTitle": "Bluetooth LE",
  "@connectTransportBleTitle": {
    "description": "Title of the Bluetooth LE tile on the connect screen, and the transport name on the “last adapter used” line. A product name — byte-identical in both languages, per docs/i18n/do-not-translate.md."
  },
  "connectTransportClassicDescription": "RFCOMM / SPP — the most common budget ELM327",
  "@connectTransportClassicDescription": {
    "description": "Subtitle of the Bluetooth Classic tile on the connect screen. RFCOMM, SPP and ELM327 are on docs/i18n/do-not-translate.md. Must NOT say pairing can be skipped: Classic is the one transport the app cannot pair for the driver (connectAnswerClassic and connectClassicEmptyPaired carry that instruction)."
  },
  "connectTransportClassicTitle": "Bluetooth Classic",
  "@connectTransportClassicTitle": {
    "description": "Title of the Bluetooth Classic tile on the connect screen, and the transport name on the “last adapter used” line. A product name — byte-identical in both languages, per docs/i18n/do-not-translate.md."
  },
  "connectTransportDemoDescription": "A built-in simulated ECU — the whole app with no hardware",
  "@connectTransportDemoDescription": {
    "description": "Subtitle of the Demo tile on the connect screen. ECU is on docs/i18n/do-not-translate.md. Scoped to the app deliberately: Demo crosses no radio, no socket and no vehicle, so it must not be described as evidence that a car will work (docs/field-guide.zh-TW.md:27-32)."
  },
  "connectTransportDemoTitle": "Demo simulator",
  "@connectTransportDemoTitle": {
    "description": "Title of the Demo tile on the connect screen. Same English as wearDemoSimulator, which names the same feature on the watch face."
  },
  "connectTransportWifiDescription": "A TCP port, usually 192.168.0.10:35000",
  "@connectTransportWifiDescription": {
    "description": "Subtitle of the Wi-Fi tile on the connect screen. The address is a literal on docs/i18n/do-not-translate.md and must stay byte-identical in both languages."
  },
  "connectTransportWifiTitle": "Wi-Fi",
  "@connectTransportWifiTitle": {
    "description": "Title of the Wi-Fi tile on the connect screen, and the transport name on the “last adapter used” line. A product name — byte-identical in both languages, per docs/i18n/do-not-translate.md."
  },
  "connectWhichIntro": "Never mind the words SPP and GATT. Go by what your adapter does once it is plugged in:",
  "connectWhichNoteGuessing": "Guessing wrong costs nothing — if it will not connect, come back and try another. If you are really stuck, use the Demo simulator at the bottom to confirm the app itself is working.",
  "@connectWhichNoteGuessing": {
    "description": "Permission to fail. The fear of picking wrong is what makes somebody close the app instead of tapping something."
  },
  "connectWhichNoteIos": "An iPhone can only use Wi-Fi or BLE — an ordinary Bluetooth ELM327 does not work at all on iOS. That is an OS limit, and no other app gets around it.",
  "connectWhichTitle": "Not sure which to pick?",
  "@connectWhichTitle": {
    "description": "Accepts the uncertainty rather than demanding a confident choice. Not Choose your connection type."
  },
  "connectWifiHostLabel": "IP address",
  "connectWifiHostRequired": "Enter the IP address of the adapter.",
  "connectWifiInstructionsDesktop": "Connect this computer to the Wi-Fi hotspot the adapter broadcasts first, then enter its address. If the system warns that the network cannot reach the internet, choose to stay on it. Desktop systems usually treat the hotspot as the default route; the Android Wi-Fi route binding is not needed.",
  "connectWifiInstructionsPhone": "Join the Wi-Fi hotspot the adapter broadcasts on the phone first, then enter its address. If the system asks whether to stay on a Wi-Fi network that cannot reach the internet, choose to stay on it. On Android, Telltale tries to pin its traffic to the Wi-Fi route while connected, so mobile data does not take it away.",
  "connectWifiPortInvalid": "“{value}” is not a valid port. The range is {min}–{max}.",
  "@connectWifiPortInvalid": {
    "description": "{value} is what the user typed, echoed back. {min}/{max} come from the range the connect check enforces.",
    "placeholders": {
      "value": {
        "type": "String"
      },
      "min": {
        "type": "int"
      },
      "max": {
        "type": "int"
      }
    }
  },
  "connectWifiPortLabel": "Port",
  "connectWifiPortRequired": "Enter the port (most adapters use {port}).",
  "@connectWifiPortRequired": {
    "description": "{port} is WifiTransport.defaultPort. Never spell the number into the sentence.",
    "placeholders": {
      "port": {
        "type": "int"
      }
    }
  },
  "dashboardBatchedPolling": "Batched polling",
  "@dashboardBatchedPolling": {
    "description": "Pill label only when a Mode 01 command this connection packed two or more PIDs. Permission without that record stays dashboardBatchingEnabled. Must not be used for profile-response grouping."
  },
  "dashboardBatchingEnabled": "Batching enabled",
  "@dashboardBatchingEnabled": {
    "description": "Pill label while PriorityScheduler.fastModeEnabled AND canBatch are both true and no grouped Mode 01 command has been observed this connection. Neither flag is a record that any exchange grouped anything. Says enabled, never active, batched or verified."
  },
  "dashboardChoosePids": "Choose PIDs",
  "dashboardEmptyBody": "Pick the signals you want to watch on the PID page and they will appear here.",
  "dashboardEmptyTitle": "The dashboard is empty",
  "dashboardGenericObd": "Generic OBD",
  "dashboardLocalRecordings": "Local recordings",
  "dashboardNotConnected": "Not connected",
  "@dashboardNotConnected": {
    "description": "Stands in for an adapter name before anything is connected. A real device name is passed through untranslated."
  },
  "dashboardPollingModeHelpAction": "About polling mode",
  "@dashboardPollingModeHelpAction": {
    "description": "Accessible name of the button the polling-mode pill sits inside. It opens an explanation and sends nothing to the adapter."
  },
  "dashboardPollingModeHelpBatching": "Batching enabled means Telltale may group PID requests into one exchange, to cut the number of round trips: grouped attempts are permitted and nothing has turned grouping off. It is still permission rather than a measurement, because whether a given exchange grouped anything also depends on which PIDs the vehicle has confirmed and on how many are waiting.",
  "@dashboardPollingModeHelpBatching": {
    "description": "Explains the enabled side of the pill, which is shown only when PriorityScheduler.fastModeEnabled and canBatch are both set. Must not claim that grouping was observed."
  },
  "dashboardPollingModeHelpObserved": "Batched polling means a Mode 01 command this connection actually carried more than one PID. It is a record of that exchange, not a promise that the next one will group, and not a claim about throughput.",
  "@dashboardPollingModeHelpObserved": {
    "description": "Explains the observed-batch side of the pill. Shown in the same dialog as the permission and fallback paragraphs. Must name Mode 01 so a powertrain profile response is not counted."
  },
  "dashboardPollingModeHelpRate": "PIDs/s is a rate observed over the last second, not a promise about latency, freshness or accuracy. It moves with the adapter, the bus, the ECU, the PIDs you selected, how large each reply is, and any errors.",
  "@dashboardPollingModeHelpRate": {
    "description": "Keeps the throughput pill separate from the polling mode. PIDs/s is on docs/i18n/do-not-translate.md and stays byte-identical in both languages."
  },
  "dashboardPollingModeHelpSingle": "Single request mode means each Mode 01 PID is read on its own. Telltale uses it when the bus does not take grouped requests at all, which is every non-CAN vehicle; while no support block has answered yet, because grouping PIDs the vehicle has not confirmed is what makes a reply come back short; and after a grouped request fails to come back in a form it can split apart again, whether truncated, refused because the adapter reported its buffer full, or unanswered. Readings carry on updating, and on its own this is not a connection failure.",
  "@dashboardPollingModeHelpSingle": {
    "description": "Explains the fallback side of the pill, which covers three different states and cannot tell them apart: a bus that never groups (not CAN); a CAN bus where PollingEngine has not yet had a support block answered, so canBatch is still false and grouping is held back on purpose; and grouping withdrawn after a bad reply. The third names what the three paths into PriorityScheduler.handleCorruptionEvent share rather than only the truncated-frame one — an unanswered batch is silence, not a garbled reply, and this codebase does not let those be confused. Says Mode 01 because a powertrain profile response is drained as one batch either way."
  },
  "dashboardPollingModeHelpTitle": "Polling mode",
  "@dashboardPollingModeHelpTitle": {
    "description": "Title of the dialog behind the polling-mode pill."
  },
  "dashboardSingleRequestMode": "Single request mode",
  "@dashboardSingleRequestMode": {
    "description": "Pill label whenever PriorityScheduler.fastModeEnabled or canBatch is false. Either way popBatch stops grouping Mode 01 PIDs, so single-request is what the state proves rather than what it permits. The other side of the pill is dashboardBatchingEnabled, which needs both; the raw fastMode identifier stays in logs and code and is no longer rendered."
  },
  "dashboardVinRead": "VIN read",
  "dashboardWorkspaceGauges": "Gauges",
  "dashboardWorkspaceTrends": "Trends",
  "datumBadgeCommunityDecode": "Community decode",
  "@datumBadgeCommunityDecode": {
    "description": "EvidenceKind.community. A claim about the SOURCE of the decode, never about this car; it is always shown together with datumBadgeUnverifiedOnThisVehicle."
  },
  "datumBadgeDemo": "Simulated",
  "@datumBadgeDemo": {
    "description": "DatumOrigin.demo. The number came from Telltale's own simulator, not from a vehicle. This has to be unmistakable: a simulated reading that passes for a live one is the worst thing this app can do."
  },
  "datumBadgeEstimated": "Estimated",
  "@datumBadgeEstimated": {
    "description": "DatumOrigin.calculated. Computed from a vehicle profile, never read off the bus. Estimated is not measured, and the two must stay two different words."
  },
  "datumBadgeExperimental": "Experimental",
  "@datumBadgeExperimental": {
    "description": "EvidenceKind.experimental. Always shown with datumBadgeUnverifiedOnThisVehicle."
  },
  "datumBadgeFieldVerified": "Field-verified",
  "@datumBadgeFieldVerified": {
    "description": "EvidenceKind.fieldVerified. Verified on a real vehicle, which is why the English says field rather than just verified — a catalog entry passing validation is not this."
  },
  "datumBadgeInvalid": "Invalid",
  "@datumBadgeInvalid": {
    "description": "DatumQuality.invalid. The datum failed a structural check and may not be read as a value at all. Distinct from datumBadgeUnverified, which says nothing about the value."
  },
  "datumBadgeJustUpdated": "Just updated",
  "@datumBadgeJustUpdated": {
    "description": "The value arrived on the most recent poll. The opposite pole of datumBadgeStale; never render either as the other."
  },
  "datumBadgeOutOfReferenceRange": "Out of range",
  "@datumBadgeOutOfReferenceRange": {
    "description": "DatumQuality.outOfReferenceRange. A check was run against the definition's own minimum and maximum and the value fell outside it. Not merely 'unusual' — a check failed, and the reading is kept rather than hidden."
  },
  "datumBadgePartial": "Partial",
  "@datumBadgePartial": {
    "description": "DatumQuality.partial. Something was not read. Partial is not all clear and must never read as a completed or fault-free result."
  },
  "datumBadgeStale": "Stale",
  "@datumBadgeStale": {
    "description": "DatumQuality.stale. The reading stopped updating. Stale is not live; a reading that stopped updating must never render as a current one."
  },
  "datumBadgeTentativeDecode": "Tentative decode",
  "@datumBadgeTentativeDecode": {
    "description": "DatumQuality.tentativeDecode. The bytes were decoded with a formula that is not confirmed for this vehicle."
  },
  "datumBadgeUnverified": "Unverified",
  "@datumBadgeUnverified": {
    "description": "EvidenceKind.notTested and EvidenceKind.unknown. Nobody has checked this against a real vehicle. Unverified is not invalid and it is not verified; it is a statement about evidence, not about the number."
  },
  "datumBadgeUnverifiedOnThisVehicle": "Unverified on this vehicle",
  "@datumBadgeUnverifiedOnThisVehicle": {
    "description": "The second half of the community and experimental pairs. The source may be corroborated elsewhere; nobody has driven it on THIS car. Never shorten to 'unverified' — the scope is the whole point."
  },
  "datumBadgeUserSupplied": "User-supplied",
  "@datumBadgeUserSupplied": {
    "description": "DatumOrigin.userEntered and EvidenceKind.userSupplied. The definition came from the person holding the phone, so the app makes no claim about it."
  },
  "datumGapModelYearUnknown": "Model year unknown",
  "@datumGapModelYearUnknown": {
    "description": "DatumGap.modelYearUnknown. One of the optional identification gaps listed on the dashboard session chip. None of them blocks generic OBD."
  },
  "datumGapNoCatalogMatch": "No catalog match",
  "@datumGapNoCatalogMatch": {
    "description": "DatumGap.noCatalogMatch. The catalog holds no entry for this vehicle. Not a fault, and not a reason to stop reading generic OBD."
  },
  "datumGapVinNotRead": "VIN not read",
  "@datumGapVinNotRead": {
    "description": "DatumGap.vinNotRead. A read outcome, never a claim that the vehicle has no VIN. VIN is on docs/i18n/do-not-translate.md."
  },
  "datumNextStepEstimateOnly": "This affects only the estimate; the other readings still apply.",
  "@datumNextStepEstimateOnly": {
    "description": "DatumNextStep.estimateOnlyOtherReadingsUnaffected. Scopes a failed estimate so nobody reads it as the session going wrong."
  },
  "datumNextStepGenericObd": "You can carry on with generic OBD, or choose the vehicle by hand and fill in the parameters.",
  "@datumNextStepGenericObd": {
    "description": "DatumNextStep.genericObdContinues. Missing identification never blocks generic OBD, and this sentence is what says so."
  },
  "datumNextStepOtherReadings": "The failure affects only this item; the other readings still apply.",
  "@datumNextStepOtherReadings": {
    "description": "DatumNextStep.otherReadingsUnaffected. One PID failing is not the session failing."
  },
  "datumNextStepRawOnly": "The raw reply and the error can be inspected; neither may be read as a normal value.",
  "@datumNextStepRawOnly": {
    "description": "DatumNextStep.rawOnlyNeverANumber. The raw bytes stay available for diagnosis, and the sentence exists to stop somebody reading them as a measurement."
