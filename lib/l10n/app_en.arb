  "appTagline": "Live vehicle telemetry",
  "appTitle": "Telltale",
  "@appTitle": {
    "description": "App name shown in window titles and the connect header."
  },
  "appearanceSectionTitle": "Appearance",
  "connectActivityAbortingPreviousConnection": "Stopping the previous connection, one moment…",
  "@connectActivityAbortingPreviousConnection": {
    "description": "ObdConnectionActivity.abortingPreviousConnection. Says the tap registered and what is being waited for; the wizard showed nothing at all here before."
  },
  "connectAnswerBleWithClassic": "Choose Bluetooth LE. It does not need pairing first — scan for it inside the app. Even if it appears in the system Bluetooth pairing list, do not pair it; that route does not work. If the scan finds nothing, the 4.0 on the box was only the chip spec — use Bluetooth Classic instead.",
  "@connectAnswerBleWithClassic": {
    "description": "Routing answer for BLE where this host also has Classic. Both halves are load-bearing: do not pair it, and what to do when a box marked 4.0 was only the chip spec."
  },
  "connectAnswerBleWithoutClassic": "Choose Bluetooth LE. It does not need pairing first — scan for it inside the app. Even if it appears in the system Bluetooth pairing list, do not pair it; that route does not work. If the scan finds nothing, check that the adapter has power, or try Wi‑Fi instead; this host does not offer Bluetooth Classic.",
  "@connectAnswerBleWithoutClassic": {
    "description": "Same answer on a host with no Classic path. Must not point at the greyed-out Classic card."
  },
  "connectAnswerClassic": "Choose Bluetooth Classic. Pair it in system settings first; the app cannot pair it for you. The code is usually 1234 or 0000.",
  "@connectAnswerClassic": {
    "description": "Classic SPP does need system pairing first. This must never tell a user to skip it."
  },
  "connectAnswerWifiDesktop": "Choose Wi-Fi. Connect this device to that network first, then come back and enter the address.",
  "connectAnswerWifiPhone": "Choose Wi-Fi. Join that network on the phone first, then come back and enter the address.",
  "connectBleBody": "A BLE adapter does not need to be paired first. Search, then pick your device — common names are OBDII, V-LINK, Vgate or IOS-Vlink.",
  "@connectBleBody": {
    "description": "A GATT device is not paired the way a Classic one is. This must never tell a user to pair a BLE adapter."
  },
  "connectBleEmptyScan": "The scan finished without finding a BLE adapter. Check in order: is the light on the adapter lit — most OBD sockets are unpowered until the ignition is at ON; then range, so sit in the car before scanning. {next} A BLE adapter does not need, and should not have, pairing in system settings; that route does not work.",
  "@connectBleEmptyScan": {
    "description": "{next} is one whole sentence, either connectBleEmptyScanNextClassic or connectBleEmptyScanNextWifi, chosen by whether this host has Bluetooth Classic.",
    "placeholders": {
      "next": {
        "type": "String"
      }
    }
  },
  "connectBleEmptyScanNextClassic": "Last, check the spec on the box: if it says 2.0 or 3.0 that is Bluetooth Classic, which never appears in this list, so use Bluetooth Classic above instead.",
  "@connectBleEmptyScanNextClassic": {
    "description": "A Classic adapter can never appear in a BLE scan, so an empty result has to offer that branch."
  },
  "connectBleEmptyScanNextWifi": "Last, check the spec on the box: if it says 2.0/3.0, or Wi‑Fi only, try Wi‑Fi instead (this host does not offer Bluetooth Classic).",
  "connectBlePermissionDeniedForever": "Bluetooth permission is permanently denied. The system will not ask again, so turn it on in app settings.",
  "connectBlePermissionNeeded": "Bluetooth permission is needed to search.",
  "connectBleScan": "Search for BLE devices",
  "connectBleScanning": "Searching…",
  "connectBleUnavailableHost": "Bluetooth LE is not available on this host yet",
  "connectBluetoothOff": "Bluetooth is off. Turn Bluetooth on in system settings first.",
  "connectBluetoothPermissionDeniedForever": "Bluetooth permission is permanently denied. Turn it on in system settings, then try again.",
  "@connectBluetoothPermissionDeniedForever": {
    "description": "Bonded-adapter list. Names Bluetooth: listing a bonded adapter never asks for location, so location can not be the permission that was refused here."
  },
  "connectBluetoothPermissionNeededForPairedList": "Bluetooth permission is needed to list paired adapters.",
  "connectBody": "Plug in an ELM327 adapter and switch the ignition on, or use the built-in simulator.",
  "connectCancel": "Cancel",
  "connectClassicEmptyLinuxPort": "No Bluetooth serial port (/dev/rfcomm*) found. Pair the ELM327 with BlueZ first, then create an RFCOMM TTY with rfcomm bind (or the equivalent) and try again.",
  "connectClassicEmptyPaired": "No paired adapter found. Pair it in the system Bluetooth settings first (the code for most ELM327s is 1234 or 0000).",
  "connectClassicEmptyWindowsPort": "No Bluetooth serial port (COMx) found. Pair the ELM327 in the Windows Bluetooth settings first, and check that Device Manager shows “Standard Serial over Bluetooth link”.",
  "connectClassicListLinuxPort": "This lists the Bluetooth serial ports BlueZ has bound (/dev/rfcomm* or the equivalent). An empty list means the system has not created an RFCOMM node yet, not that the app is broken.",
  "@connectClassicListLinuxPort": {
    "description": "An empty port list is a system state, not an app fault. Serial hosts never list headphones."
  },
  "connectClassicListPaired": "This lists every device paired with the system — headphones and speakers included, with the ones that look like adapters first. If you pick the wrong one, press Cancel rather than waiting for it to fail; you can pick another straight away.",
  "connectClassicListWindowsPort": "This lists the COM ports associated with Bluetooth (“Standard Serial over Bluetooth link”). An empty list means the system has not created a virtual serial port yet, not that the app is broken.",
  "connectClassicUnavailableHost": "Bluetooth Classic (SPP) is currently available on Android, macOS (IOBluetooth RFCOMM), Windows (COM) and Linux (/dev/rfcomm*)",
  "@connectClassicUnavailableHost": {
    "description": "Why the Classic card is greyed out on a host with no SPP path. Keep currently: the host list changes."
  },
  "connectClassicUnavailableIos": "iOS does not open Bluetooth SPP to third-party apps",
  "@connectClassicUnavailableIos": {
    "description": "iOS only. A permanent OS limit, not a missing feature."
  },
  "connectConnect": "Connect",
  "connectDemoBody": "Simulates a 2.0 L turbocharged four-cylinder engine through idle, acceleration, cruise and deceleration cycles, with signals that stay physically related to each other (engine speed drops on a gearshift while road speed keeps rising). Fault codes, VIN reads and fastMode batch queries all work in full.",
  "connectDemoStart": "Start the simulator",
  "connectHandshakeTitle": "ELM327 initialisation",
  "connectHandshakeTitleLastAttempt": "ELM327 initialisation (last attempt)",
  "@connectHandshakeTitleLastAttempt": {
    "description": "Past tense, so a panel full of green rows cannot be read as the current connection."
  },
  "connectHeadline": "Choose a connection",
  "connectIssueAdapterAcceptedThenSilent": "The adapter accepted the connection but answered nothing in time. Usually it is not powered yet — most OBD sockets only supply power with the ignition on — or another app is already connected to it, in which case close that one and try again.",
  "@connectIssueAdapterAcceptedThenSilent": {
    "description": "ObdConnectionIssue.adapterAcceptedThenSilent. Both causes are load-bearing: an unpowered socket and a second app holding the adapter look identical from here, and naming only one sends half the readers looking in the wrong place."
  },
  "connectIssueAdapterSilentOnReset": "The adapter did not answer the reset command ({command}). This device may not be an ELM327 adapter, or the connection may have gone to the wrong device.",
  "@connectIssueAdapterSilentOnReset": {
    "description": "ObdConnectionIssue.adapterSilentOnReset. Failing on the very first command is a different diagnosis from failing later, and the command is named rather than described. {command} is an AT command and is never translated.",
    "placeholders": {
      "command": {
        "type": "String"
      }
    }
  },
  "connectIssueAdapterStoppedResponding": "The adapter stopped responding and the connection has been dropped.",
  "@connectIssueAdapterStoppedResponding": {
    "description": "ObdConnectionIssue.adapterStoppedResponding. States what already happened, not a warning about what might."
  },
  "connectIssueConnectionSetupFailed": "The connection failed while it was being established. Check that the adapter has power and is nearby, then try again. The full error is kept in the log below.",
  "@connectIssueConnectionSetupFailed": {
    "description": "ObdConnectionIssue.connectionSetupFailed. The raw exception text is deliberately not shown here; it is written to the transcript, which is where somebody can act on it."
  },
  "connectIssueHandshakeIncomplete": "Initialisation did not pass. The adapter may not be compatible.",
  "@connectIssueHandshakeIncomplete": {
    "description": "ObdConnectionIssue.handshakeIncomplete. No step reported a failure, so this is the least specific thing that is still true. It must stay a possibility, never a verdict on the adapter."
  },
  "connectIssueHandshakeStepFailed": "Initialisation failed at {command} ({reason}). Check that the adapter is seated properly and the vehicle's ignition is on.",
  "@connectIssueHandshakeStepFailed": {
    "description": "ObdConnectionIssue.handshakeStepFailed. Which command died is the whole value of this message: it separates 'this is not an ELM327' from 'the adapter is fine but the ignition is off'. {command} is an AT command or a mode/PID and is never translated; {reason} is the step's own outcome.",
    "placeholders": {
      "command": {
        "type": "String"
      },
      "reason": {
        "type": "String"
      }
    }
  },
  "connectIssuePreviousConnectionStillAborting": "The previous connection is still being stopped and the adapter has not been released yet. Wait a few seconds and try again.",
  "@connectIssuePreviousConnectionStillAborting": {
    "description": "ObdConnectionIssue.previousConnectionStillAborting. A refusal that says what happened and what to do about it; a silent false here was the defect this replaced."
  },
