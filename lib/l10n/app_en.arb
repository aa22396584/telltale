  "connectQuestionClassic": "Neither — an older one, with 2.0 or 3.0 printed on the box?",
  "connectQuestionWifiDesktop": "Is there a new network in the Wi-Fi list on the system (something like V-LINK or WiFi_OBDII)?",
  "connectQuestionWifiPhone": "Is there a new network in the Wi-Fi list on the phone (something like V-LINK or WiFi_OBDII)?",
  "connectSearchAgain": "Search again",
  "connectSignalStrength": "Signal strength {bars}/{total}",
  "@connectSignalStrength": {
    "description": "Semantics label for the signal meter. {total} comes from the number of bars drawn, not from prose.",
