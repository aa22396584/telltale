  "dtcReadinessTitle": "Emissions readiness",
  "dtcReadinessSaysNothing": "This controller reported no readiness monitors at all — it may not be responsible for emissions monitoring, and that does not mean it is ready.",
  "@dtcReadinessSaysNothing": {
    "description": "A module outside emissions monitoring answers with all zeroes. Reading that as a clean bill of health turns silence into an answer."
  },
  "dtcReadinessAllComplete": "Every readiness monitor this controller is responsible for is complete.",
  "dtcReadinessIncomplete": "{count, plural, =1{1 monitor is still unfinished} other{{count} monitors are still unfinished}} — an inspection now may not pass.",
  "@dtcReadinessIncomplete": {
    "description": "Counts monitors this app cannot name as well, so one left unfinished still blocks 'ready'.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "dtcUnknownMonitor": "Unknown monitor",
  "@dtcUnknownMonitor": {
    "description": "A readiness monitor the vehicle reported and this app has no name for. It is still counted as unfinished — not being able to name it is not permission to discount it. Never 'N/A' or 'other'."
  },
  "dtcListSeparator": ", ",
  "@dtcListSeparator": {
    "description": "Joins fault codes, categories or controller ids in a sentence. Chinese uses the enumeration comma; English uses a comma and a space."
