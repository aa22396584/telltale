    "description": "Where a recorded telemetry session came from: the app's own simulated ECU. A reader must never mistake a simulated session for a drive."
  },
  "telemetrySourceRig": "Test rig",
  "@telemetrySourceRig": {
    "description": "Where a recorded telemetry session came from: a simulated hardware rig used in testing, not a vehicle."
  },
  "telemetrySourceFieldApp": "Field app connection",
  "@telemetrySourceFieldApp": {
    "description": "Where a recorded telemetry session came from: an ordinary connection made by the field build to a real adapter."
  },
  "fuelTypeGasoline": "Petrol",
  "@fuelTypeGasoline": {
    "description": "Fuel type in the vehicle profile. British 'petrol' rather than American 'gas', because 'gas' also means LPG to many readers and this list contains LPG."
  },
  "fuelTypeDiesel": "Diesel",
  "fuelTypeLpg": "LPG",
  "@fuelTypeLpg": {
    "description": "Liquefied petroleum gas. The abbreviation is the common name in English; do not expand it."
  },
  "fuelTypeEthanolE85": "E85 ethanol",
  "drivetrainFwd": "Front-wheel drive",
  "drivetrainRwd": "Rear-wheel drive",
  "drivetrainAwd": "All-wheel drive",
  "assumptionFieldMass": "Mass",
  "@assumptionFieldMass": {
    "description": "A vehicle parameter an estimate rests on: the vehicle's mass including the driver."
  },
  "assumptionFieldDragCoefficient": "Cd",
  "@assumptionFieldDragCoefficient": {
    "description": "Drag coefficient. The symbol is the same in every language; do not translate or expand it."
  },
  "assumptionFieldFrontalArea": "Frontal area",
  "assumptionFieldRollingResistance": "Rolling resistance",
  "assumptionFieldDrivetrainEfficiency": "Drivetrain efficiency",
  "assumptionFieldFuelType": "Fuel",
  "assumptionFieldStoichAfr": "AFR",
  "@assumptionFieldStoichAfr": {
    "description": "Stoichiometric air-fuel ratio. The abbreviation is standard; do not expand it."
  },
  "assumptionFieldFuelDensity": "Density",
  "assumptionFieldDisplacement": "Displacement",
  "assumptionFieldVolumetricEfficiency": "VE",
  "@assumptionFieldVolumetricEfficiency": {
    "description": "Volumetric efficiency. The abbreviation is standard; do not expand it."
  },
  "vehicleFieldOriginGenericDefault": "generic default",
  "@vehicleFieldOriginGenericDefault": {
    "description": "Where an assumed parameter came from: nothing about this vehicle, just a value typical of cars. The weakest of the five, and the reader must be able to tell it apart from the others at a glance — it is the difference between an estimate about their car and an estimate about a car."
  },
  "vehicleFieldOriginUserEntered": "entered by you",
  "@vehicleFieldOriginUserEntered": {
    "description": "Where an assumed parameter came from: the reader typed it in. Not verified by the app, and must not be worded as if it were."
  },
  "vehicleFieldOriginOfficialRegistry": "official registry",
  "@vehicleFieldOriginOfficialRegistry": {
    "description": "Where an assumed parameter came from: the bundled official vehicle registry data."
  },
  "vehicleFieldOriginManufacturerPublication": "manufacturer data",
  "@vehicleFieldOriginManufacturerPublication": {
    "description": "Where an assumed parameter came from: a figure the manufacturer published."
  },
  "vehicleFieldOriginScientificModel": "model coefficient",
  "@vehicleFieldOriginScientificModel": {
    "description": "Where an assumed parameter came from: a coefficient from a physical model rather than from this vehicle. An estimate, and the wording must not suggest a measurement."
  },
  "assumptionWithOrigin": "{field} {value} ({origin})",
  "@assumptionWithOrigin": {
    "description": "One line of the estimate-assumptions list. The brackets are ASCII here and fullwidth in Chinese; that punctuation is part of the translation, not decoration.",
    "placeholders": {
      "field": {
        "type": "String"
      },
      "value": {
        "type": "String"
      },
      "origin": {
        "type": "String"
      }
    }
  },
  "assumptionWithoutOrigin": "{field} {value}",
  "@assumptionWithoutOrigin": {
    "description": "One line of the estimate-assumptions list, for a parameter that follows from the fuel type and so has no separate origin.",
    "placeholders": {
      "field": {
        "type": "String"
      },
      "value": {
        "type": "String"
      }
    }
  },
  "assumptionSeparator": "; ",
  "@assumptionSeparator": {
    "description": "Joins the assumption lines. English uses a semicolon and a space; Chinese uses the fullwidth semicolon and no space. Using the English one in Chinese, or the reverse, is a defect this project has shipped before."
  },
  "datumFormulaHorsepower": "wheelWatts = (m·a + ½ρ·Cd·A·v² + Crr·m·g)·v; engineHp = wheelHp / drivetrainEfficiency",
  "@datumFormulaHorsepower": {
    "description": "The power estimate's formula, shown so a reader can check the working. Symbols and operators must not be translated; only the identifier words could be, and are better left as they are."
  },
  "datumFormulaFuelRate": "L/h = (MAF g/s) / (AFR × fuel density g/L) × 3600; MAF is either PID 0110 or speed-density (RPM × MAP × displacement × VE / T_K); L/100km = (L/h) / speed_kmh × 100",
  "@datumFormulaFuelRate": {
    "description": "The fuel estimate's formula. Only the connecting words are translatable; PID 0110, MAF, MAP, VE and the units are not."
  },
  "datumAssumptionsFromRecording": "The estimate uses the vehicle settings as they were when this was recorded.",
  "@datumAssumptionsFromRecording": {
    "description": "Shown in the estimate details for a replayed session whose file did not store the parameter list. It must not imply the settings were verified, only that they are the ones in force at record time."
  },
  "adapterConcernFirmwareNeverReleasedSummary": "Reports firmware v{version}, which was never released",
  "@adapterConcernFirmwareNeverReleasedSummary": {
    "description": "Clone-adapter detection. Elm Electronics never shipped this version number, so the firmware is not the one the adapter says it is. Must not be softened into a compatibility note: the point is that the device's account of itself is unreliable.",
    "placeholders": {
      "version": {
        "type": "String"
      }
    }
  },
  "adapterConcernFirmwareNeverReleasedDetail": "Elm Electronics never published this version, so the firmware on this adapter is not the one it claims. Many of these still work — but its description of itself cannot be trusted, and it is worth suspecting first when something will not read.",
  "adapterConcernPpsRefusedSummary": "Claims v{version}, yet does not know ATPPS, which v1.1 had",
  "@adapterConcernPpsRefusedSummary": {
    "description": "Clone-adapter detection: the claimed version and the implemented command set contradict each other. ATPPS and the version numbers are protocol tokens and are not translated.",
    "placeholders": {
      "version": {
        "type": "String"
      }
    }
  },
  "adapterConcernPpsRefusedDetail": "The programmable-parameter summary (ATPPS) has existed since ELM327 v1.1, and even high-end adapters such as OBDLink support it. The version it claims and the commands it actually implements do not line up.",
  "adapterConcernNoIdentitySummary": "Does not answer AT@1, the device-identity command from the first release",
  "adapterConcernNoIdentityDetail": "This command has existed since ELM327 v1.0. Not answering it means this chip implements a smaller command set than any official firmware.",
  "telemetryReplaySampled": "The preview is sampled; the export keeps every recorded event.",
  "@telemetryReplaySampled": {
    "description": "Shown under a replayed session's chart, always. The chart a reader is looking at is not the whole recording, and this sentence is the only thing that says so — dropping or softening it lets somebody read a sampled curve as a complete one."
  },
  "telemetryExportDisclosure": "The export contains signal names, values, observation and source times, transport kind, protocol, frozen PID labels, units and formulas, and the estimate assumptions (mass, drag, displacement, fuel and similar parameters). JSON may also contain your own custom labels, units, formulas and complete frozen definitions. The export does not contain the VIN, GPS, an account, the adapter address, the full vehicle profile, or raw diagnostic traffic.",
  "@telemetryExportDisclosure": {
    "description": "Shown on the export sheet. It is where the app tells the reader what leaves the device, and it is what the store listing's 'no personal data collected' rests on. Both halves are load-bearing: the enumeration of what IS included, and the enumeration of what is NOT. Do not shorten either."
  },
  "connectTransportCancelled": "The connection attempt was stopped before it finished.",
  "@connectTransportCancelled": {
    "description": "TransportIssue.cancelled. Not a failure of the adapter or the link, and it must not read like one: the user backed out, or a newer attempt replaced this one."
  },
  "connectTransportWifiRouteNoNetwork": "The phone is not on any Wi-Fi network, so there is no route to the adapter. Connect to the adapter's Wi-Fi hotspot, then try again.",
  "@connectTransportWifiRouteNoNetwork": {
    "description": "TransportIssue.wifiRouteNoNetwork. The only one of the route failures where \"connect to the hotspot\" is the right remedy — the transport used to say it for all of them."
  },
  "connectTransportWifiRouteAmbiguous": "The phone is on more than one Wi-Fi network and none of them is clearly the adapter's, so none was chosen. Disconnect the ones that are not the adapter's, then try again.",
  "@connectTransportWifiRouteAmbiguous": {
    "description": "TransportIssue.wifiRouteAmbiguous. Plural: the platform reports how many networks were equally plausible and it can exceed two. Says why nothing was picked rather than guessing — picking one at random is how a connection goes to the wrong network and blames the adapter."
  },
  "connectTransportWifiRouteRefused": "The system refused to send this connection over Wi-Fi. The phone is on Wi-Fi; it was not allowed to be used for this.",
  "@connectTransportWifiRouteRefused": {
    "description": "TransportIssue.wifiRouteRefused. Distinct from having no network, and the distinction is the whole message: telling someone to join a hotspot they are already on wastes the one thing they can act on."
  },
  "connectTransportWifiRouteTimeout": "The system did not answer the request to send this connection over Wi-Fi. Wait a few seconds and try again.",
  "@connectTransportWifiRouteTimeout": {
    "description": "TransportIssue.wifiRouteTimeout. States what did not happen, not what is wrong; the platform call may still complete afterwards, which is why the app releases the route regardless."
  },
  "connectTransportWifiRouteUnclassified": "The connection could not be sent over Wi-Fi, for a reason the system did not name. The full error is kept in the log below.",
  "@connectTransportWifiRouteUnclassified": {
    "description": "TransportIssue.wifiRouteUnclassified. An unrecognised platform code must never borrow another failure's remedy, so this one deliberately offers none."
  },
  "connectTransportWifiHostUnreachable": "Nothing answered at that address. Check the phone is on the adapter's Wi-Fi hotspot — if the system asked whether to stay connected without internet, choose to stay. Turning mobile data off can also help.",
  "@connectTransportWifiHostUnreachable": {
    "description": "TransportIssue.wifiHostUnreachable. The \"stay connected without internet\" prompt is the most common cause and is invisible afterwards, so it is named rather than described."
  },
  "connectTransportWifiConnectTimeout": "Nothing answered at that address in time.",
  "@connectTransportWifiConnectTimeout": {
    "description": "TransportIssue.wifiConnectTimeout. Says nothing answered, not that an adapter is there: a timeout establishes silence, and someone who typed the wrong address would otherwise read a verdict on hardware they never reached. The address is in the log below."
  },
  "connectTransportWifiRouteRestoreFailed": "The connection worked, but the phone's network routing could not be put back, so the connection was dropped rather than left changed. Restart the app and try again.",
  "@connectTransportWifiRouteRestoreFailed": {
    "description": "TransportIssue.wifiRouteRestoreFailed. The connection is dropped on purpose: leaving the phone's routing altered by an app that could not undo it is worse than losing the session."
  },
  "connectTransportBleLinkFailed": "Could not connect to the adapter. Check that it has power and is within range.",
  "@connectTransportBleLinkFailed": {
    "description": "TransportIssue.bleLinkFailed. The link never came up, so nothing is known about what the device is."
  },
  "connectTransportBleNoSerialCharacteristic": "The device connected, but no serial port was found on it, so it may not be an ELM327 adapter.",
  "@connectTransportBleNoSerialCharacteristic": {
    "description": "TransportIssue.bleNoSerialCharacteristic. What was not found, stated as what was not found. Some adapters expose the pair only after a delay, so \"may not be\" is the strongest claim available."
  },
  "connectTransportClassicAllTiersRefused": "Could not connect to the adapter. Pair it in the system Bluetooth settings first, and check that it is plugged into the OBD socket with the ignition on.",
  "@connectTransportClassicAllTiersRefused": {
    "description": "TransportIssue.classicAllTiersRefused. Every Bluetooth Classic tier was refused; unpaired is the most common cause by a wide margin, which is why the copy names it while the identifier does not."
  },
  "connectTransportClassicConnectTimeout": "Connecting to the adapter timed out. It may still be answering — wait a few seconds rather than retrying straight away.",
  "@connectTransportClassicConnectTimeout": {
    "description": "TransportIssue.classicConnectTimeout. Retrying immediately tends to make this worse, which is why the wait is stated rather than implied."
  },
  "connectTransportSerialPortOpenFailed": "Could not open the serial port. Check that the system has created one for this adapter (COMx on Windows, /dev/rfcomm* on Linux) and that the ignition is on.",
  "@connectTransportSerialPortOpenFailed": {
    "description": "TransportIssue.serialPortOpenFailed. Desktop only. The port is created by the operating system, not by this app, so the remedy is outside it."
  },
  "connectTransportSerialDroppedOnOpen": "The serial port opened and closed again immediately.",
  "@connectTransportSerialDroppedOnOpen": {
    "description": "TransportIssue.serialDroppedOnOpen. Distinct from failing to open: something answered, then went away."
  },
  "settingsManualCommandNotConnected": "Nothing is connected, so the command was not sent.",
  "@settingsManualCommandNotConnected": {
    "description": "TransportIssue.notConnected. Refused before any byte left the app, which is the one case where \"not sent\" is a fact rather than an inference, so it is stated flatly."
  },
  "settingsManualCommandLinkDropped": "The connection to the adapter dropped while this command was in flight, so nothing answered it. Whether the adapter received the command is not known.",
  "@settingsManualCommandLinkDropped": {
    "description": "TransportIssue.linkDroppedMidSession. The link went away without being asked to. It must not claim the command was not sent: the bytes may already have left, and a manual command can be one that changes something."
  },
  "settingsManualCommandDisconnectedByApp": "The app closed the connection while this command was in flight, so nothing answered it. Nothing is wrong with the adapter or the vehicle.",
  "@settingsManualCommandDisconnectedByApp": {
    "description": "TransportIssue.disconnectedByApp. Carries the same Chinese sentence in the engine as linkDroppedMidSession and must not read like it: told that their connection dropped when they closed it themselves, somebody goes looking for a fault in a car that has none."
  },
  "settingsManualCommandAdapterSilentOnResync": "The adapter's replies had fallen out of step with the commands sent to it, and it did not answer the check that would have put them back in step, so the connection was dropped. Connect again before retrying.",
  "@settingsManualCommandAdapterSilentOnResync": {
    "description": "TransportIssue.adapterSilentOnResync. Says what the app could no longer do - tell which reply belongs to which command - rather than diagnosing the adapter. Carrying on would have attributed answers to the wrong questions, which is the failure this app is arranged against."
  },
  "settingsManualCommandLinkStoppedResponding": "Nothing arrived from the adapter for long enough that the connection was dropped. It may still have power; what is known is the silence.",
  "@settingsManualCommandLinkStoppedResponding": {
    "description": "TransportIssue.linkStoppedResponding. A watchdog timeout establishes silence and nothing else, so it must not read as a verdict on the adapter. Distinct from linkDroppedMidSession, where the transport itself reported the link gone."
  },
  "settingsManualCommandWriteFailed": "The command could not be handed to the adapter's connection. How much of it reached the adapter is not known.",
  "@settingsManualCommandWriteFailed": {
    "description": "TransportIssue.writeFailed. Not a connect failure - it happens on an open link and reaches this panel, not the connect screen. The hedge is load-bearing: a write that failed part way has already put bytes on the wire."
  },
  "settingsManualCommandTimedOut": "No reply arrived before the time limit. Confirm the adapter is connected and the ignition is on.",
  "@settingsManualCommandTimedOut": {
    "description": "TimeoutException from Elm327Client.send on the manual-command panel. The engine sentence is transcript-only; interpolating it would put English on a Traditional Chinese screen. Distinct from linkStoppedResponding: the command timer fired, not the watchdog."
  },
  "settingsManualCommandOperationRetired": "This session has ended or gone to the background, so the command was not sent.",
  "@settingsManualCommandOperationRetired": {
    "description": "TransportIssue.operationRetired. The app stopped asking; nothing is wrong with the adapter or the vehicle. Distinct from notConnected: a link may still exist, but this command's owner expired before any byte left."
  },
  "settingsManualCommandRequestUnaddressable": "This request cannot be addressed on the bus this vehicle is using, so it was not sent. Trying again will not change that.",
  "@settingsManualCommandRequestUnaddressable": {
    "description": "TransportIssue.requestUnaddressable. Structural: no header on this bus reaches the named controller. Distinct from queryHeaderRefused, where the adapter declined ATSH, and from notConnected, where there is no link."
  },
  "settingsManualCommandCustomFlowControlRejected": "The adapter refused a custom flow-control command, so the requested mode was not applied and no measurement was produced.",
  "@settingsManualCommandCustomFlowControlRejected": {
    "description": "TransportIssue.customFlowControlRejected. The adapter answered ATFCSH, ATFCSD or ATFCSM1|2 with '?'. Distinct from unknownCommand as a generic adapter status and from busError: nothing was asked of the vehicle, and no decoded value may be shown."
  },
  "settingsManualCommandFlowControlRestoreFailed": "The adapter refused to restore default flow control (ATFCSM0), so polling is stopped until you reconnect.",
  "@settingsManualCommandFlowControlRestoreFailed": {
    "description": "TransportIssue.flowControlRestoreFailed. ATFCSM0 did not answer OK. Distinct from customFlowControlRejected: the apply already failed or finished, and default FC could not be put back. ATFCSM0 is a machine token."
  },
  "settingsManualCommandExtendedAddressingUnavailable": "Extended addressing is not available on this ELM327 path.",
  "@settingsManualCommandExtendedAddressingUnavailable": {
    "description": "TransportIssue.extendedAddressingUnavailable. Always-unavailable in the typed-FC slice; ATCEA is not implemented. Named so capability reporting cannot claim it."
  },
  "settingsManualCommandRawIsoTpModeUnavailable": "Host-visible ISO-TP reassembly is not available on this ELM327 path.",
  "@settingsManualCommandRawIsoTpModeUnavailable": {
    "description": "TransportIssue.rawIsoTpModeUnavailable. Always-unavailable in the typed-FC slice; ATCAF0 host reassembly is deferred. Named so capability reporting cannot claim it. ISO-TP is a machine token."
  },
  "manualCommandRefusedEmpty": "Nothing was typed, so nothing was sent.",
  "@manualCommandRefusedEmpty": {
    "description": "ManualCommandRefusalReason.emptyCommand. The box refuses before the adapter is involved at all, so it must not read as a failure of anything."
  },
  "manualCommandRefusedMoreThanOneCommand": "This text carries a line break or another control character, which sends more than one command at once. The adapter separates commands by line break, so the second one would skip every check made here \u2014 including the one that refuses to clear fault codes. Send one command at a time.",
  "@manualCommandRefusedMoreThanOneCommand": {
    "description": "ManualCommandRefusalReason.moreThanOneCommand. The mechanism is the message: 03\\r04 is two requests and the second one erases the vehicle's fault memory. Saying only 'refused' would leave somebody retrying the same paste."
  },
  "manualCommandRefusedAdapterStateWouldChange": "This box accepts questions, not commands that change what the adapter is. \u201c{command}\u201d would change the adapter's state while the app's model of it stayed as it was \u2014 the readings after it could come from a different controller, with nothing on screen to say so.\nQueries you can send: {allowed}.",
  "@manualCommandRefusedAdapterStateWouldChange": {
    "description": "ManualCommandRefusalReason.adapterStateWouldChange. {command} is the text as typed and {allowed} is manualCommandAdvertisedAtQueries joined with settingsListSeparator, never a list spelled into the sentence: copy that named seven queries while the set accepted more was a false statement about what this box takes, read by the one person whose command was just refused. No count here: it is what drifted.",
    "placeholders": {
      "command": {},
      "allowed": {}
    }
  },
  "manualCommandRefusedClearHasItsOwnButton": "To clear fault codes, use the Clear button on the fault-code screen. Sent from here it would skip the confirmation, the coverage check and the response validation, and it would reach only the one controller currently selected.",
  "@manualCommandRefusedClearHasItsOwnButton": {
    "description": "ManualCommandRefusalReason.clearHasItsOwnButton. Mode 04. It names where to go rather than only refusing, because the thing the person wanted is available and safeguarded a screen away."
  },
  "manualCommandRefusedCharactersNoObdCommandHas": "The command \u201c{command}\u201d contains characters an OBD command never has. This box takes hexadecimal service codes and parameters \u2014 0100, 03, 2211A6 \u2014 or an adapter query beginning with AT.",
  "@manualCommandRefusedCharactersNoObdCommandHas": {
    "description": "ManualCommandRefusalReason.charactersNoObdCommandHas. A whitelist rather than a list of separators to keep complete: the cost of an incomplete blacklist here is a fault-code clear nobody asked for.",
    "placeholders": {
      "command": {}
    }
  },
  "manualCommandRefusedNotAReadOnlyQuery": "\u201c{command}\u201d is not a command this box knows. It takes read-only queries (Mode {allowed}) and adapter queries.",
  "@manualCommandRefusedNotAReadOnlyQuery": {
    "description": "ManualCommandRefusalReason.notAReadOnlyQuery. {allowed} is manualCommandAdvertisedServices joined with settingsListSeparator. The list was once written out beside the set and the two had already drifted: Mode 05 was admitted and the sentence still omitted it.",
    "placeholders": {
      "command": {},
      "allowed": {}
    }
  },
  "commandFailureQueryHeaderRefused": "The adapter refused to aim this request at controller {header}, so it was not sent. Left on whatever address the adapter is really holding, the reply would have come back from a controller nobody asked.",
  "@commandFailureQueryHeaderRefused": {
    "description": "TransportIssue.queryHeaderRefused. The adapter answered ATSH with '?'. It must not read as a failure of the vehicle: nothing was asked of the vehicle at all. The address is interpolated because a reader who cannot see which controller was meant has nothing to act on.",
    "placeholders": {
      "header": {}
    }
  },
  "commandFailureWholeVehicleHeaderRefused": "The adapter refused to switch to address {address}, which is what a question asked of the whole vehicle has to go out on. Without it, replies cannot be matched to the controllers that sent them, so the request was not made.",
  "@commandFailureWholeVehicleHeaderRefused": {
    "description": "TransportIssue.wholeVehicleHeaderRefused. Separate from queryHeaderRefused because what is lost differs: a scan, a clear or a VIN read is answered by the whole emissions system, and an unattributable answer to it cannot be shown as a whole-vehicle result. Says what could not be established, not that the adapter is broken.",
    "placeholders": {
      "address": {}
    }
  },
  "commandFailureLegacyScanWouldBePartial": "This vehicle uses an older bus with no standard address that reaches every controller, and the adapter is currently set to controller {installed}. A scan would have covered that one controller alone while being presented as the whole vehicle, so it was not sent. Reconnect, then scan again.",
  "@commandFailureLegacyScanWouldBePartial": {
    "description": "TransportIssue.legacyScanWouldBePartial. Nothing failed - the app refused. The sentence has to say that the result would have looked clean and complete, because a partial scan presented as a whole-vehicle one is the failure this app is arranged against.",
    "placeholders": {
      "installed": {}
    }
  },
  "pidFormulaEmpty": "The formula is empty.",
  "@pidFormulaEmpty": {
    "description": "FormulaIssue.emptyFormula. Nothing was typed at all."
  },
  "pidFormulaEmptySubExpression": "Part of the formula is empty — an operator with nothing after it, or brackets with nothing in them.",
  "@pidFormulaEmptySubExpression": {
    "description": "FormulaIssue.emptySubExpression. Not the same as an empty formula: something was typed, and the remedy is to finish it rather than to write one."
  },
  "pidFormulaUnbalancedParentheses": "The brackets do not match: every ( needs a closing ).",
  "@pidFormulaUnbalancedParentheses": {
    "description": "FormulaIssue.unbalancedParentheses. The bracket characters are formula syntax and are the same in both languages."
  },
  "pidFormulaUnparsableTerm": "“{term}” is not a number, an operator, or a name this editor understands.",
  "@pidFormulaUnparsableTerm": {
    "description": "FormulaIssue.unparsableTerm. {term} is the fragment the reducer stopped on, quoted back exactly as it stands in the formula so the author can find it.",
    "placeholders": {
      "term": {
        "type": "String"
      }
    }
  },
  "pidFormulaFunctionNestingTooDeep": "ABS(), LOG10(), LOG() and SQRT() are nested too deeply to evaluate. Simplify the formula.",
  "@pidFormulaFunctionNestingTooDeep": {
    "description": "FormulaIssue.functionNestingTooDeep. Names the construct to simplify; the bracket depth limit has its own message."
  },
  "pidFormulaParenthesisNestingTooDeep": "The brackets are nested too deeply to evaluate. Simplify the formula.",
  "@pidFormulaParenthesisNestingTooDeep": {
    "description": "FormulaIssue.parenthesisNestingTooDeep. A different construct from the function limit, so a different sentence: the author has to find a different thing."
  },
  "pidFormulaDivisionByZero": "The formula divides by zero.",
  "@pidFormulaDivisionByZero": {
    "description": "FormulaIssue.divisionByZero. Separate from the modulo case: the character to look for is a different one."
  },
  "pidFormulaModuloByZero": "The formula takes a remainder modulo zero.",
  "@pidFormulaModuloByZero": {
    "description": "FormulaIssue.moduloByZero."
  },
  "pidFormulaLog10NonPositiveArgument": "LOG10 needs an argument greater than 0, and this one came out as {argument}.",
  "@pidFormulaLog10NonPositiveArgument": {
    "description": "FormulaIssue.log10NonPositiveArgument. {argument} is the value the argument reduced to, never spelled into the sentence. Answering 0 for an impossible input is what this refusal exists to avoid.",
    "placeholders": {
      "argument": {
        "type": "double"
      }
    }
  },
  "pidFormulaLogNonPositiveArgument": "LOG needs an argument greater than 0, and this one came out as {argument}.",
  "@pidFormulaLogNonPositiveArgument": {
    "description": "FormulaIssue.logNonPositiveArgument. Natural log, not LOG10. {argument} is the value the argument reduced to. Answering 0 for an impossible input is what this refusal exists to avoid.",
    "placeholders": {
      "argument": {
        "type": "double"
      }
    }
  },
  "pidFormulaSqrtNegativeArgument": "SQRT needs an argument of 0 or greater, and this one came out as {argument}.",
  "@pidFormulaSqrtNegativeArgument": {
    "description": "FormulaIssue.sqrtNegativeArgument. {argument} is the value the argument reduced to. Zero is allowed; a negative argument has no real square root and must not become 0.",
    "placeholders": {
      "argument": {
        "type": "double"
      }
    }
  },
  "pidFormulaResultNotFinite": "The arithmetic produced no usable number, so there is no reading to show.",
  "@pidFormulaResultNotFinite": {
    "description": "FormulaIssue.resultNotFinite. Covers a non-finite intermediate as well as a non-finite result: both mean there is no reading, and rendering either as 0 is the failure this app is arranged against."
  },
  "pidFormulaByteBeyondResponse": "The formula refers to byte {letter}, but the reply carried only {count} bytes.",
  "@pidFormulaByteBeyondResponse": {
    "description": "FormulaIssue.byteBeyondResponse. {letter} is A..N and is formula syntax, not a word. Substituting 0 for a byte the ECU did not send produces a confident wrong number, which is why this is a refusal.",
    "placeholders": {
      "letter": {
        "type": "String"
