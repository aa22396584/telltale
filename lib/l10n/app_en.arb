  "dtcVerdictCompleteClean": "No fault codes from the controllers that answered",
  "@dtcVerdictCompleteClean": {
    "description": "Header subtitle for ScanVerdict.completeClean. The qualifier 'that answered' is the whole hedge: this is the line a glance lands on, and it must never read as 'this vehicle has no faults'."
  },
  "dtcVerdictPartialClean": "Partially unconfirmed",
  "@dtcVerdictPartialClean": {
    "description": "ScanVerdict.partialClean. Some categories could not be read, so the verdict is incomplete. Keep it short and distinct from dtcUnconfirmed; never merge the two into one 'unknown'."
  },
  "dtcUnconfirmed": "Cannot confirm",
  "@dtcUnconfirmed": {
    "description": "Two call sites, one sentence: the header subtitle for any other verdict, and the headline of a category that failed to answer. Must never be read as 'no problem'."
  },
  "dtcClear": "Clear",
  "dtcClearing": "Clearing…",
  "dtcRescanFirst": "Rescan first",
  "@dtcRescanFirst": {
    "description": "Label of the disabled clear button. The button IS the verdict of the last clear: something may already have been erased, so a second global Mode 04 would reset a completed controller's readiness. Keep it an imperative."
  },
  "dtcDismiss": "Dismiss",
  "@dtcDismiss": {
    "description": "Tooltip that closes the clear-outcome panel. Closing a message is not learning what happened; only a rescan is."
  },
  "dtcClearDialogTitle": "Clear fault codes?",
  "dtcClearDialogBody": "This erases stored and pending fault codes and turns the fault lamp off, and it also resets emissions readiness — the vehicle has to complete a full round of self-diagnosis again before it can pass an inspection. Permanent fault codes (Mode 0A) cannot be cleared.",
  "@dtcClearDialogBody": {
    "description": "The point of no return. Mode 0A permanent codes must never read as something this clear can remove."
  },
  "dtcClearDialogFrames": "The freeze frame for {codes} goes with it — the whole record of engine speed, coolant temperature and load at the moment the fault happened — and it cannot be read back until the fault happens again.",
  "@dtcClearDialogFrames": {
    "description": "Fault codes come back if the fault recurs; the snapshot of the moment it first happened does not.",
    "placeholders": {
      "codes": {}
    }
  },
  "dtcClearDialogFrameUnread": "This scan did not read a freeze frame — that does not mean the vehicle has none. Rescan first, then decide whether to clear.",
  "@dtcClearDialogFrameUnread": {
    "description": "A read failure, not an absent frame. Collapsing the two causes irreversible evidence loss."
  },
  "dtcClearDialogUnanswered": "{count, plural, =1{One category in this scan did not answer completely} other{{count} categories in this scan did not answer completely}} ({categories}), so there may be fault codes you have not seen. After a clear they can never be read again.",
  "@dtcClearDialogUnanswered": {
    "description": "What the scan could not establish, said at the point of no return.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "categories": {}
    }
  },
  "dtcClearCancel": "Cancel",
  "dtcClearConfirm": "Clear them",
  "dtcNotConnectedTitle": "Not connected",
  "dtcNotConnectedBody": "Reading fault codes needs a connected ELM327 adapter, or the simulator running.",
  "dtcScanTitle": "Scan the vehicle for fault codes",
  "dtcScanBody": "Reads Mode 03 stored, Mode 07 pending and Mode 0A permanent fault codes.",
  "@dtcScanBody": {
    "description": "The three classes are three different things and must stay distinguishable."
  },
  "dtcReadFailed": "Read failed",
  "@dtcReadFailed": {
    "description": "Two call sites, one sentence: the empty-state title after a failed scan, and the headline of a category whose read errored rather than went silent."
  },
  "dtcScanning": "Scanning…",
  "dtcStartScan": "Start scan",
  "dtcRetry": "Retry",
  "@dtcRetry": {
    "description": "Retries the fault-code scan. Deliberately not shared with startupRetry: the two screens are free to reword independently."
  },
  "dtcFreezeFrameUnreadPanel": "This scan did not read a freeze frame — that does not mean the vehicle has none. Rescan first, then decide whether to clear the fault codes, because clearing destroys the record of the moment of the fault permanently. If every scan looks the same, this vehicle may not provide one.",
  "@dtcFreezeFrameUnreadPanel": {
    "description": "A controller with no stored frame shows nothing, which is exactly what a failed read shows. Saying so is the only thing standing between a Mode 02 timeout and a clear."
  },
  "dtcCompleteCleanTitle": "None of the controllers that answered reported a fault code.",
  "@dtcCompleteCleanTitle": {
    "description": "'that answered' is the whole hedge. Never render this as 'no fault codes' or 'your car is fine'."
  },
  "dtcCompleteCleanBody": "That means every controller that replied reported no fault code. It does not mean every module on the vehicle was asked.",
  "@dtcCompleteCleanBody": {
    "description": "A controller whose reply is lost outright leaves nothing to count as missing, and the app has no inventory of who should have answered."
  },
  "dtcPartialCleanTitle": "The categories that answered reported no fault codes.",
  "dtcPartialCleanOptionalGaps": "All three categories were queried to completion. {count, plural, =1{One controller} other{{count} controllers}} ({controllers}) implement neither pending nor permanent fault codes — normal on many vehicles, and also why this cannot be declared a fault-free vehicle.",
  "@dtcPartialCleanOptionalGaps": {
    "description": "Modes 07 and 0A are optional in SAE J1979. A vehicle that implements neither is compliant and fine; that is a different situation from a class nobody answered.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "controllers": {}
    }
  },
  "dtcPartialCleanUnanswered": "{categories} did not answer, so their state cannot be confirmed — that is not the same as the vehicle having no problem.",
  "@dtcPartialCleanUnanswered": {
    "placeholders": {
      "categories": {}
    }
  },
