  "connectClassicUnavailableIos": "iOS does not open Bluetooth SPP to third-party apps",
  "@connectClassicUnavailableIos": {
    "description": "iOS only. A permanent OS limit, not a missing feature."
  },
  "connectClassicUnavailableHost": "Bluetooth Classic (SPP) is currently available on Android, macOS (IOBluetooth RFCOMM), Windows (COM) and Linux (/dev/rfcomm*)",
  "@connectClassicUnavailableHost": {
    "description": "Why the Classic card is greyed out on a host with no SPP path. Keep currently: the host list changes."
